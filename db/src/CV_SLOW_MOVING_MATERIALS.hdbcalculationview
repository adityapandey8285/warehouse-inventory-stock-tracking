  <calculationView xsi:type="Calculation:ProjectionView" id="P_SLOW_MOVING">
    <viewAttributes>
      <viewAttribute id="MATERIAL_ID"/>
      <viewAttribute id="LOCATION_ID"/>
      <viewAttribute id="CURRENT_STOCK"/>
      <viewAttribute id="LAST_ISSUE_DATE"/>
      <viewAttribute id="PLANT_ID"/>
      <viewAttribute id="PLANTCODE"/>
      <viewAttribute id="PLANTNAME"/>
      <viewAttribute id="LOCATIONCODE"/>
      <viewAttribute id="LOCATIONNAME"/>
      <viewAttribute id="MATERIALCODE"/>
      <viewAttribute id="MATERIALNAME"/>
      <viewAttribute id="UNITOFMEASURE"/>
      <viewAttribute id="UNITPRICE"/>
      <viewAttribute id="STOCK_VALUE"/>
    </viewAttributes>
    <calculatedViewAttributes>
      <calculatedViewAttribute id="DAYS_SINCE_LAST_ISSUE" datatype="INTEGER" expressionLanguage="SQL">
        <formula>CASE
    WHEN &quot;LAST_ISSUE_DATE&quot; IS NULL THEN 99999
    ELSE DAYS_BETWEEN(&quot;LAST_ISSUE_DATE&quot;, CURRENT_DATE)
END</formula>
      </calculatedViewAttribute>
      <calculatedViewAttribute id="MOVEMENT_STATUS" datatype="NVARCHAR" length="30" expressionLanguage="SQL">
        <formula>CASE
    WHEN &quot;LAST_ISSUE_DATE&quot; IS NULL THEN 'Never Issued'
    ELSE 'Previously Issued'
END</formula>
      </calculatedViewAttribute>
    </calculatedViewAttributes>
    <input node="JOIN_STOCK_ISSUE"/>
  </calculationView>
  <calculationView xsi:type="Calculation:ProjectionView" id="P_FILTER_SLOW_MOVING" filterExpressionLanguage="SQL">
    <viewAttributes>
      <viewAttribute id="MATERIAL_ID"/>
      <viewAttribute id="LOCATION_ID"/>
      <viewAttribute id="CURRENT_STOCK"/>
      <viewAttribute id="LAST_ISSUE_DATE"/>
      <viewAttribute id="DAYS_SINCE_LAST_ISSUE"/>
      <viewAttribute id="MOVEMENT_STATUS"/>
      <viewAttribute id="PLANT_ID"/>
      <viewAttribute id="PLANTCODE"/>
      <viewAttribute id="PLANTNAME"/>
      <viewAttribute id="LOCATIONCODE"/>
      <viewAttribute id="LOCATIONNAME"/>
      <viewAttribute id="MATERIALCODE"/>
      <viewAttribute id="MATERIALNAME"/>
      <viewAttribute id="UNITOFMEASURE"/>
      <viewAttribute id="UNITPRICE"/>
      <viewAttribute id="STOCK_VALUE"/>
    </viewAttributes>
    <calculatedViewAttributes/>
    <input node="P_SLOW_MOVING"/>
    <filter>&quot;CURRENT_STOCK&quot; &gt; 0
AND &quot;DAYS_SINCE_LAST_ISSUE&quot; &gt;= $$IP_DAYS$$</filter>
  </calculationView>
</calculationViews>

