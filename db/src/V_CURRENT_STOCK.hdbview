VIEW "V_CURRENT_STOCK" AS
SELECT
    M."materialCode" AS "MATERIAL_CODE",
    M."materialName" AS "MATERIAL_NAME",
    L."locationCode" AS "LOCATION_CODE",
    P."plantCode" AS "PLANT_CODE",
    M."unitOfMeasure" AS "UNIT",
    SUM(
        CASE
            WHEN SM."movementType" = 'RECEIPT'
                AND SM."storageLocation_ID" = L."ID"
                THEN SM."quantity"
            WHEN SM."movementType" = 'ISSUE'
                AND SM."storageLocation_ID" = L."ID"
                THEN -SM."quantity"
            WHEN SM."movementType" = 'TRANSFER'
                AND SM."sourceLocation_ID" = L."ID"
                THEN -SM."quantity"
            WHEN SM."movementType" = 'TRANSFER'
                AND SM."targetLocation_ID" = L."ID"
                THEN SM."quantity"
            ELSE 0
        END
    ) AS "CURRENT_STOCK"
FROM "warehouse_inventory_StockMovements" SM
JOIN "warehouse_inventory_Materials" M
    ON SM."material_ID" = M."ID"
JOIN "warehouse_inventory_StorageLocations" L
    ON L."ID" = SM."storageLocation_ID"
    OR L."ID" = SM."sourceLocation_ID"
    OR L."ID" = SM."targetLocation_ID"
JOIN "warehouse_inventory_Plants" P
    ON L."plant_ID" = P."ID"
GROUP BY
    M."materialCode",
    M."materialName",
    L."locationCode",
    P."plantCode",
    M."unitOfMeasure";
