@baseUrl = http://localhost:4004/inventory
@materialId = 10000001-0000-0000-0000-000000000001
@sl01 = aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
@sl02 = bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb
@sl03 = cccccccc-cccc-cccc-cccc-cccccccccccc
@sl06 = ffffffff-ffff-ffff-ffff-ffffffffffff
@invalidId = 99999999-9999-9999-9999-999999999999


### GET 1 - Plants

GET {{baseUrl}}/Plants


### GET 2 - Storage Locations

GET {{baseUrl}}/StorageLocations


### GET 3 - Materials

GET {{baseUrl}}/Materials


### GET 4 - Stock Movements

GET {{baseUrl}}/StockMovements


### GET 5 - MAT001 Movements

GET {{baseUrl}}/StockMovements?$filter=material_ID%20eq%20%27{{materialId}}%27


### POST 6 - Valid Receipt

POST {{baseUrl}}/receive
Content-Type: application/json

{
  "materialId": "{{materialId}}",
  "storageLocationId": "{{sl01}}",
  "quantity": 10,
  "movementDate": "2026-10-08T12:30:00Z",
  "reference": "TEST-GRN-001"
}


### POST 7 - Receipt Zero Quantity

POST {{baseUrl}}/receive
Content-Type: application/json

{
  "materialId": "{{materialId}}",
  "storageLocationId": "{{sl01}}",
  "quantity": 0,
  "movementDate": "2026-10-08T12:31:00Z",
  "reference": "TEST-GRN-ZERO"
}


### POST 8 - Receipt Invalid Material

POST {{baseUrl}}/receive
Content-Type: application/json

{
  "materialId": "{{invalidId}}",
  "storageLocationId": "{{sl01}}",
  "quantity": 10,
  "movementDate": "2026-10-08T12:32:00Z",
  "reference": "TEST-GRN-BAD"
}


### POST 9 - Valid Issue

POST {{baseUrl}}/issue
Content-Type: application/json

{
  "materialId": "{{materialId}}",
  "storageLocationId": "{{sl01}}",
  "quantity": 5,
  "movementDate": "2026-10-08T12:35:00Z",
  "reference": "TEST-ISS-001"
}


